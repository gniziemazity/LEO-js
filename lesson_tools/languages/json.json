{
	"id": "json",
	"extensions": [".json"],
	"comments": { "line": null, "block": null },
	"strings": [{ "open": "\"", "close": "\"", "escape": "\\" }],
	"keywords": ["true", "false", "null"],
	"builtins": [],
	"identifierRe": "[a-zA-Z_][a-zA-Z0-9_]*",
	"numberRe": "-?\\d+\\.?\\d*([eE][+-]?\\d+)?",
	"indent": {
		"increaseAfter": "[{(\\[]\\s*$",
		"decreaseOnLine": "^[})\\]]",
		"decreaseAfter": ""
	}
}
